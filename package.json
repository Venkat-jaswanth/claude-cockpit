{
  "name": "claude-cockpit",
  "version": "0.5.0",
  "description": "A local control room for Claude Code: run sessions in the background, attach from your browser or Terminal, search and organize your history, and manage several accounts with live usage, all from one dashboard.",
  "type": "module",
  "bin": {
    "cockpit": "bin/cockpit.js"
  },
  "scripts": {
    "daemon": "node src/daemon.js",
    "test": "node test/e2e.js"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "cli",
    "dashboard",
    "usage",
    "rate-limit",
    "multi-account",
    "session-manager",
    "terminal",
    "background-sessions",
    "pty"
  ],
  "author": "Venkat Jaswanth",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Venkat-jaswanth/claude-cockpit.git"
  },
  "homepage": "https://github.com/Venkat-jaswanth/claude-cockpit#readme",
  "bugs": {
    "url": "https://github.com/Venkat-jaswanth/claude-cockpit/issues"
  },
  "files": [
    "bin/",
    "src/",
    "web/"
  ],
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=20"
  }
}
